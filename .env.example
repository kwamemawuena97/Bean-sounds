# --- Backend ---
ENV=development
LOG_LEVEL=INFO

# Gemini for lyrics generation
GEMINI_API_KEY=

# Optional: Lyria via Vertex AI for real audio (leave blank to use mock audio)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
LYRIA_MODEL=lyria-002

DATABASE_URL=sqlite:///./bean_sounds.db
AUDIO_STORAGE_DIR=./audio_storage
AUDIO_PUBLIC_PREFIX=/audio

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_KEY=
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_AUDIO=5/minute

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=
